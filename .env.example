# ── Football Widget — Environment Variables ──────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env file (it's in .gitignore).

# ── API Provider ─────────────────────────────────────────────────────────────
# Options: 'api-football' | 'football-data' | 'mock' (default, no key needed)
VITE_API_PROVIDER=mock

# ── API Key ───────────────────────────────────────────────────────────────────
# API-Football (RapidAPI):    https://rapidapi.com/api-sports/api/api-football
# Football-Data.org:          https://www.football-data.org/client/register
VITE_API_KEY=

# ── Teams to follow (comma-separated team IDs) ────────────────────────────────
# Leave blank to show fixtures from major leagues instead of a specific team.
# API-Football team IDs: Man Utd=33, Arsenal=42, Liverpool=40, Chelsea=49, etc.
# Football-Data.org team IDs: Man Utd=66, Arsenal=57, Liverpool=64, etc.
VITE_TEAM_IDS=

# ── Leagues to show when TEAM_IDS is blank (API-Football league IDs) ─────────
# 39=Premier League, 2=Champions League, 3=Europa League, 848=Conference League
VITE_LEAGUE_IDS=39,2,3
